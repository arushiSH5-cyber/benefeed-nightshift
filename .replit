modules = ["nodejs-20", "python-3.12"]
run = "cd web && npm ci && npm run build && cd .. && pip install -q uv && uv sync --no-dev && uv run uvicorn server.app:app --host 0.0.0.0 --port 8080"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "cd web && npm ci && npm run build && cd .. && pip install -q uv && uv sync --no-dev"]
run = ["sh", "-c", "uv run uvicorn server.app:app --host 0.0.0.0 --port 8080"]
