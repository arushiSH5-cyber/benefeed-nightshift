run = "cd web && npm ci && npm run build && cd .. && pip install uv && uv run uvicorn server.app:app --host 0.0.0.0 --port 8080"
[[ports]]
localPort = 8080
externalPort = 80
[deployment]
build = ["sh", "-c", "cd web && npm ci && npm run build"]
run = ["sh", "-c", "pip install uv && uv run uvicorn server.app:app --host 0.0.0.0 --port 8080"]
